{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectTabi",
  "version": "0.1.1+3",
  "identifier": "com.ch1zume.projecttabi.desktop",
  "build": {
    "beforeDevCommand": "npm run build:web:desktop:debug",
    "beforeBuildCommand": "npm run build:web:desktop",
    "frontendDist": "../build/web",
    "devUrl": "http://127.0.0.1:8791"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ProjectTabi",
        "width": 430,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQUIzRUEwNzkyRUJCQ0IKUldUTHV5NTVvRDZySysxR25FeG9WZ2MvTzY1VG85YU9mUEVsYzVuU2t4M1RmK1E5ZVR5bUk3Q0gK",
      "endpoints": ["https://github.com/Ch1Zume/ProjectTabi/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
